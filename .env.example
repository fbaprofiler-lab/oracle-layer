# Oracle Layer — Environment Configuration
# Copy to .env and fill in your keys

# ==================== MACRO DATA SOURCES ====================
# EIA Open Data API (free, instant)
# Get at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# FRED (St. Louis Fed) API (free)
# Get at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# NOAA/NWS API (free, no key required for basic usage)
# NOAA_API_TOKEN=optional_for_higher_rate_limits

# JODI Data (free, monthly, no API key)
# JODI_BASE_URL=https://www.jodidata.org/

# OPEC MOMR (free PDF, public)
# OPEC_MOMR_URL=https://www.opec.org/opec_web/en/publications/202.htm

# OFAC Sanctions Lists (free XML/CSV)
# OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.xml

# ==================== PREDICTION MARKETS ====================
# Polymarket Data API (public, no key required for basic)
# Higher rate limits with API key from Polymarket
POLYMARKET_API_KEY=optional_for_higher_limits

# Gamma API (Polymarket metadata, public)
GAMMA_API_URL=https://gamma-api.polymarket.com

# ==================== JEV / TYPE SAFE ====================
# TypeSafe Jev API (early access required)
# Request at: https://typesafe.ai/
TYPE SAFE_API_KEY=your_typesafe_api_key_here
TYPE SAFE_BASE_URL=https://api.typesafe.ai/v1

# Jev model configuration
JEV_MODEL=jev
JEV_TIMEOUT_MS=5000
JEV_MAX_RETRIES=3

# ==================== HIGGSFIELD ====================
# Higgsfield API (for generative explainers)
# Get at: https://higgsfield.ai/
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
HIGGSFIELD_WORKSPACE_ID=your_workspace_id

# Video generation defaults
HIGGSFIELD_VIDEO_MODEL=seedance_2_5
HIGGSFIELD_VIDEO_DURATION=30
HIGGSFIELD_VIDEO_ASPECT=16:9
HIGGSFIELD_VIDEO_RESOLUTION=1080p

# ==================== TELEGRAM ====================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed chat IDs (comma-separated) for consumer bot
TELEGRAM_ALLOWED_CHAT_IDS=7728232980

# Webhook URL for production (optional)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# ==================== DATABASE ====================
# PostgreSQL/TimescaleDB for time-series storage
# Format: postgresql://user:pass@host:port/dbname
DATABASE_URL=postgresql://oracle:oracle@localhost:5432/oracle_layer

# Redis for caching (optional)
REDIS_URL=redis://localhost:6379/0

# ==================== APPLICATION ====================
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8000

# WebSocket server
WS_HOST=0.0.0.0
WS_PORT=8001

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=60

# ==================== FEATURE FLAGS ====================
# Enable/disable components
ENABLE_MACRO_PIPELINE=true
ENABLE_MARKET_ANALYSIS=true
ENABLE_JEV_JUDGMENT=true
ENABLE_HIGGSFIELD_EXPLAINERS=true
ENABLE_TELEGRAM_BOT=true
ENABLE_WEBSOCKET_API=true
ENABLE_WEB_DASHBOARD=false

# Calibration settings
CALIBRATION_LOOKBACK_DAYS=180
CALIBRATION_MIN_SAMPLES=100
CALIBRATION_METHOD=temperature_scaling  # or isotonic, conformal

# Explainer settings
EXPLAINER_TRIGGER_MOVE_PCT=3.0
EXPLAINER_MAX_AGE_HOURS=4
EXPLAINER_VIDEO_DURATION=30

# Wallet intelligence
WALLET_MIN_TRADES=30
WALLET_MAX_TRADES_PER_DAY=50
WALLET_MIN_CLUSTERS=10